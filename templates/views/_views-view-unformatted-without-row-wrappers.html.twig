{#
/**
 * @file
 * Default theme implementation to display a view of unformatted rows.
 *
 * Available variables:
 * - title: The title of this group of rows. May be empty.
 * - title_heading: The title heading (h2,h3,h4,h5,h6), defaut (h3)
 * - rows: A list of the view's row items.
 *   - attributes: The row's HTML attributes.
 *   - content: The row's content.
 * - view: The view object.
 * - default_row_class: A flag indicating whether default classes should be
 *   used on rows.
 * - row_container: container tag
 * - row_container_attributes: optional attributes
 *
 * @see template_preprocess_views_view_unformatted()
 *
 * @ingroup themeable
 */
#}
{% apply spaceless %}
  {% block blockTitle %}
    {% if title %}
      <{{ title_heading ?? 'h3' }}>{{ title }}</{{ title_heading ?? 'h3' }}>
    {% endif %}
  {% endblock %}

  {% if row_container %}
    <{{ row_container }}{{ row_container_attributes ? row_container_attributes }}>
      {% for row in rows %}
        {{- row.content -}}
      {% endfor %}
    </{{ row_container }}>
  {% else %}
    {% for row in rows %}
      {{- row.content -}}
    {% endfor %}
  {% endif %}
{% endapply %}
