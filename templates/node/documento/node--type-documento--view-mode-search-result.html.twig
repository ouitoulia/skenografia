{% set _title_prefix %}
  Documento
  {% if content.field_protocollo[0] is iterable %}
   - {{ content.field_protocollo }} {{ content.field_data_inizio }}
  {% endif %}
  - {{ content.field_tipologia_documento }}
{% endset %}
{% include '@skenografia_components/card/card-highlighting-search-results.html.twig' with {
  card_variant: 'redbrown',
  title_prefix: _title_prefix,
  title_suffix: content.field_abstract,
  content: content|without('field_protocollo', 'field_data_inizio', 'field_tipologia_documento','field_abstract')
} %}
