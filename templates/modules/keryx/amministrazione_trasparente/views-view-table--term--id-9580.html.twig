{% embed '@skenografia/views/views-view-table.html.twig' %}
  {% block viewTitle %}
    {% if title|render|striptags|trim is not empty %}
      <h3 class="h4 fw-lighter">
        Codice Identificativo Gara: {{ title|striptags|trim }}
        {{ bdncpButtonLabel }}
        {% embed '@bi-bcl/button/button.html.twig' with {
          label: "Vedi su BDNCP",
          tag: 'a',
          url: 'https://dati.anticorruzione.it/superset/dashboard/dettaglio_cig/?cig=' ~ title|striptags|trim ~ '&standalone=2',
          outline: true,
          variant: 'white',
          size: 'xs',
          assistive_text: 'Vedi questa gara sul portale della Banca Dati Nazionale Contratti Pubblici',
          button_classes: ['ms-1', 'mb-1', 'btn-icon', 'text-secondary', 'border'],
          button_attributes: create_attribute().setAttribute('target', '_blank')
        } %}
          {% block after %}
            {% include '@bi-bcl/icon/icon.html.twig' with {
              name: 'it-link',
              color: 'bluelectric',
              icon_classes: ['ms-1'],
            } %}
          {% endblock %}
        {% endembed %}
      </h3>
    {% endif %}
  {% endblock %}
{% endembed %}
