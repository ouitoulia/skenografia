<div class="row variable-gutters">
  <div class="col-md-8 mb-5">
    {% block content %}{% endblock %}
    {% block afterContent %}{% endblock %}
  </div>
  <div class="col-md-4">
    <div class="mb-5">
      <h2 class="h5 fw-lighter mb-2">{{ 'Pertinenza'|t }}</h2>
      {% if _obbligo_pubblicazione %}
        <p class="text-greendark d-flex">
          <span>{% include '@bi-bcl/icon/icon.html.twig' with {name: 'it-check', color: 'greendark', icon_classes: ['me-2']} %}</span>
          <span>La scuola è soggetta a questo obbligo.</span>
        </p>
      {% else %}
        <p class="text-muted d-flex">
          <span>{% include '@bi-bcl/icon/icon.html.twig' with {name: 'it-ban', color: 'redbrown', icon_classes: ['me-2']} %}</span>
          <span>
            Non di pertinenza dell'istituzione scolastica
            (<a href="https://www.anticorruzione.it/-/determinazione-n.-430-del-13/04/2016-rif.-1" title="Leggi la delibera 430/2016 di ANAC in una nuova finestra" target="_blank">Delibera ANAC 430 del 13 aprile 2016</a>
            e/o <a href="https://www.funzionepubblica.gov.it/articolo/ministro/12-02-2016/trasparenza" title="Leggi il D.lgs. 97/2016 - FOIA e Trasparenza in una nuova finestra" target="_blank">D.lgs. 97/2016</a>).
          </span>
        </p>
      {% endif %}
    </div>
    {{ content.field_persona_responsabile }}
    {{ content.field_frequenza_aggiornamento }}
  </div>
</div>
