{# Consulenti e collaboratori #}
{% embed '@skenografia/layout/_leaf-page.html.twig' %}
  {% block contentMain %}
    {% if page and node and not node.isPublished() %}
      <div class="container">
        {% include '@bi-bcl/alert/alert.html.twig' with {
          message: "Questo contenuto è in modalità bozza. Solo gli utenti a cui sono stati assegnati i permessi possono visualizzarlo.",
          type: 'warning',
          dismissible: false
        } %}
      </div>
    {% endif %}

  {% endblock %}
{% endembed %}
